    {
      "label": "Retreat",
      "tooltip": "Fall back",
      "action": { "type": "minecraft:run_command", "command": "moba ping retreat" }
    },
    {
      "label": "Group",
      "tooltip": "Regroup on me",
      "action": { "type": "minecraft:run_command", "command": "moba ping group" }
