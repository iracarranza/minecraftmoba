.DS_Store
__pycache__/
*.pyc

# Generated Minecraft artifacts should be kept out of version control unless a
# deliberate release/artifact policy is added.
*.zip
*.mca

# Reproducible bulk worldgen outputs. Compact reports and review renders belong
# under implementation/worldgen/reports instead.
/artifacts/worldgen/*/worlds/
/artifacts/worldgen/*/packages/
/artifacts/worldgen/*/build/
/artifacts/worldgen/*/build_summary.json
